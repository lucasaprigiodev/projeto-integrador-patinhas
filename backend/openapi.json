    "/api/matches/{id}/assinar-termo": {
      "post": {
        "tags": [
          "3. Adoções e Matches (Fluxo de Estados)"
        ],
        "summary": "Assinar Digitalmente o Termo de Adoção (Exclusivo Adotante Titular)",
        "description": "Realiza a transição de estado `termo_enviado` ➔ `termo_assinado`. Valida se o termo já foi disponibilizado pela ONG e se o usuário autenticado é o adotante titular do match.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "aceiteClausulas",
                  "aceitePeriodoAdaptacao"
                ],
                "properties": {
                  "aceiteClausulas": {
                    "type": "boolean",
                    "example": true
                  },
                  "aceitePeriodoAdaptacao": {
                    "type": "boolean",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Termo assinado digitalmente com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado. Token de autenticação ausente ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "erro": "Não autorizado. Token de autenticação ausente no cabeçalho Authorization: Bearer <token>.",
                  "codigo": 401
                }
              }
            }
          },
          "403": {
            "description": "Usuário não é o adotante titular deste match."
          },
          "422": {
            "description": "Transição de estado inválida (ex: termo ainda não foi enviado pela ONG).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "erro": "Transição de estado inválida",
                  "detalhes": "O termo de adoção só pode ser assinado após ser enviado pela ONG (status atual: pendente).",
                  "codigo": 422
                }
              }
            }
          }
        }
      }
